{
  "name": "cucumber-mobilewright-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "bddgen": "bddgen -c mobilewright.config.js",
    "test": "npm run bddgen && mobilewright test",
    "test:tag": "npm run bddgen && mobilewright test --grep",
    "report": "playwright show-report playwright-report",
    "format": "eslint . --fix && prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@mobilenext/mobile-mcp": "latest",
    "@mobilewright/test": "latest",
    "@playwright/test": "1.63.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^15.0.0",
    "mobilewright": "latest",
    "playwright-bdd": "latest",
    "prettier": "^3.0.0"
  }
}
